# Optional. By default Orinasa stores its local SQLite database in ./data/orinasa.sqlite
ORINASA_DB_PATH=./data/orinasa.sqlite
ORINASA_DEMO_MODE=1

# Local search is the default; no prompt or business data leaves this machine.
ORINASA_AI_PROVIDER=off
ORINASA_AI_TIMEOUT_SECONDS=20
ORINASA_AI_RATE_LIMIT=20

# OpenAI Responses API (set ORINASA_AI_PROVIDER=openai to enable).
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Ollama (set ORINASA_AI_PROVIDER=ollama to enable).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=
